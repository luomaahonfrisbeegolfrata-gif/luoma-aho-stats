name: Update Stats

on:
  schedule:
    - cron: '0 */6 * * *'  # 6h välein, ei 30min -> ei tuki deployta
  workflow_dispatch:
  push:
    paths-ignore:
      - 'data/**'  # data päivitykset ei triggeröi uudestaan
      - '.nojekyll'

concurrency:
  group: pages-deploy
  cancel-in-progress: false  # älä keskeytä pages deployta

jobs:
  update:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install deps
        run: pip install requests
      - name: Fetch Metrix
        run: python scripts/fetch_metrix.py || true
      - name: Build stats
        run: python scripts/build_stats.py
      - name: Commit if changed
        run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add data/
          git diff --staged --quiet || (git commit -m "auto stats update" && git push)

  # Pages deploy erikseen - GitHub hoitaa automaattisesti, ei tarvita omaa deploy jobia
